# Copie para .env.local e preencha. O .env.local não vai para o git.
#
# Rodando com Supabase local (`npx supabase start`), os valores saem do
# próprio comando. Em produção, saem de Project Settings → API e → Database.

# Postgres. No Supabase hospedado, use a connection string do pooler
# (Transaction mode, porta 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# API do Supabase — usada para login e para o upload de fotos.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ATENÇÃO: dá acesso total ao banco, ignorando RLS. Só no servidor.
# Nunca renomeie para NEXT_PUBLIC_*, nunca importe de componente de cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Domínio público do site. Alimenta canonical, sitemap.xml e Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
